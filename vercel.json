{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "landing",
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/tv",
      "destination": "/api/download"
    },
    {
      "source": "/cocas.apk",
      "destination": "/api/download"
    },
    {
      "source": "/kikoiptv.apk",
      "destination": "/api/download"
    }
  ]
}
